# Upstream sources A.E.T.H.E.R builds on. Pull with:
#   vcs import src < aether.repos
# (OpenVINS is built separately in ~/ws_ov in the manual; listed here for reference.)
repositories:
  open_vins:
    type: git
    url: https://github.com/rpng/open_vins.git
    # NOTE: upstream cuts no ROS2-Jazzy release tag, so we track master here.
    # The reproducible pin lives in the Docker image: docker/Dockerfile.openvins
    # records the exact commit it built at /OPENVINS_SHA. If you build outside
    # Docker and need bit-for-bit reproducibility, replace 'master' with that SHA.
    version: master
  ros_gz:
    type: git
    url: https://github.com/gazebosim/ros_gz.git
    version: humble
