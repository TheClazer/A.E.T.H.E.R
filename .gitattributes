# A.E.T.H.E.R line-ending policy: the repo is authored on Windows but built on
# Linux (WSL / ros:jazzy), so everything the toolchain consumes is forced to LF.
* text=auto

*.sh        text eol=lf
*.py        text eol=lf
*.msg       text eol=lf
*.srv       text eol=lf
*.xml       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.sdf       text eol=lf
*.config    text eol=lf
*.md        text eol=lf
*.repos     text eol=lf
CMakeLists.txt text eol=lf

*.png  binary
*.pptx binary
*.pdf  binary
