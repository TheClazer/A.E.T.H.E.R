<?xml version="1.0" ?>
<!-- A.E.T.H.E.R drone: primitive quadrotor + stereo + HG4930-class IMU + ground truth.
     IMU noise parameterized to Honeywell HG4930 CA51 (ARW 0.04 deg/rtHr, VRW 0.03 m/s/rtHr).

     Actuation model: this is deliberately a KINEMATIC SENSOR RIG, not a dynamic
     multicopter. Gravity is disabled on every link and a VelocityControl system
     drives the body from /model/aether_drone/cmd_vel (gz.msgs.Twist). The drone
     therefore follows commanded velocities exactly while the IMU still reports
     proper acceleration (kinematic accel minus world gravity), i.e. it reads like
     a perfectly-stabilized hovering vehicle. This trades aerodynamic realism for
     a repeatable, controller-free trajectory — the honest choice for evaluating
     the VIO/integrity stack rather than a flight controller. -->
<sdf version="1.10">
  <model name="aether_drone">
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">
      <gravity>false</gravity>
      <inertial>
        <mass>1.5</mass>
        <inertia><ixx>0.015</ixx><iyy>0.015</iyy><izz>0.025</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="c"><geometry><box><size>0.30 0.30 0.10</size></box></geometry></collision>
      <visual name="v">
        <geometry><box><size>0.30 0.30 0.10</size></box></geometry>
        <material><ambient>0.12 0.16 0.21 1</ambient><diffuse>0.18 0.37 0.52 1</diffuse></material>
      </visual>

      <!-- HG4930-class IMU @ 200 Hz -->
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <topic>imu/data</topic>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>1.6968e-04</stddev>
               <bias_mean>0</bias_mean><bias_stddev>1.2e-05</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>1.6968e-04</stddev>
               <bias_mean>0</bias_mean><bias_stddev>1.2e-05</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>1.6968e-04</stddev>
               <bias_mean>0</bias_mean><bias_stddev>1.2e-05</bias_stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>2.0e-03</stddev>
               <bias_mean>0</bias_mean><bias_stddev>5.0e-04</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>2.0e-03</stddev>
               <bias_mean>0</bias_mean><bias_stddev>5.0e-04</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>2.0e-03</stddev>
               <bias_mean>0</bias_mean><bias_stddev>5.0e-04</bias_stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- stereo cameras @ 20 Hz, baseline 0.12 m -->
      <sensor name="camera_left" type="camera">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>camera/left/image_raw</topic>
        <pose>0.10 0.06 0.0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>120</far></clip>
        </camera>
      </sensor>
      <sensor name="camera_right" type="camera">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>camera/right/image_raw</topic>
        <pose>0.10 -0.06 0.0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>120</far></clip>
        </camera>
      </sensor>
    </link>

    <!-- four arms (visual only, fixed) -->
    <link name="arm_fl"><pose>0.15 0.15 -0.03 0 1.5708 0</pose><gravity>false</gravity>
      <inertial><mass>0.05</mass><inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz>
        <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="v"><geometry><cylinder><radius>0.015</radius><length>0.18</length></cylinder></geometry>
        <material><ambient>0.77 0.16 0.10 1</ambient></material></visual></link>
    <joint name="j_fl" type="fixed"><parent>base_link</parent><child>arm_fl</child></joint>
    <link name="arm_fr"><pose>0.15 -0.15 -0.03 0 1.5708 0</pose><gravity>false</gravity>
      <inertial><mass>0.05</mass><inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz>
        <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="v"><geometry><cylinder><radius>0.015</radius><length>0.18</length></cylinder></geometry>
        <material><ambient>0.77 0.16 0.10 1</ambient></material></visual></link>
    <joint name="j_fr" type="fixed"><parent>base_link</parent><child>arm_fr</child></joint>
    <link name="arm_bl"><pose>-0.15 0.15 -0.03 0 1.5708 0</pose><gravity>false</gravity>
      <inertial><mass>0.05</mass><inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz>
        <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="v"><geometry><cylinder><radius>0.015</radius><length>0.18</length></cylinder></geometry>
        <material><ambient>0.18 0.37 0.52 1</ambient></material></visual></link>
    <joint name="j_bl" type="fixed"><parent>base_link</parent><child>arm_bl</child></joint>
    <link name="arm_br"><pose>-0.15 -0.15 -0.03 0 1.5708 0</pose><gravity>false</gravity>
      <inertial><mass>0.05</mass><inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz>
        <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="v"><geometry><cylinder><radius>0.015</radius><length>0.18</length></cylinder></geometry>
        <material><ambient>0.18 0.37 0.52 1</ambient></material></visual></link>
    <joint name="j_br" type="fixed"><parent>base_link</parent><child>arm_br</child></joint>

    <!-- GROUND TRUTH: exact model pose -> /aether/ground_truth (nav_msgs/Odometry) -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>aether_drone</robot_base_frame>
      <odom_topic>aether/ground_truth</odom_topic>
      <dimensions>3</dimensions>
    </plugin>

    <!-- U2 ACTUATION: kinematic velocity drive. Subscribes (by VelocityControl
         default naming) to /model/aether_drone/cmd_vel as gz.msgs.Twist; the
         flight_director node (src/aether_flight) publishes the trajectory there
         through the ros_gz bridge. Links carry <gravity>false</gravity> so the
         rig holds altitude with zero commanded vz (see header comment). -->
    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
    </plugin>
  </model>
</sdf>
