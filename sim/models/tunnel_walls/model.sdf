<?xml version="1.0" ?>
<!-- A.E.T.H.E.R tunnel walls (world v2.2 - TEXTURE-FREE): the 200 m corridor,
     y = +/-2, height 3, as 20 solid-color striped panels per side. NO texture
     maps on purpose: this Gazebo build's ogre-next texture streamer
     (TextureGpuManager) aborts with heap corruption while loading PNG material
     maps, killing camera rendering. Solid materials render reliably. The
     deliberately uniform feature-poor stretch stays at x = 120..140 (flat grey
     both sides). The PBR-textured variant used to record the golden bag lives
     in sim/models/tunnel_walls_textured (needed if you re-record a bag for the
     real-VIO chain: KLT wants texture; see docs/AETHER_MANUAL_STEPS).
     Collision is two full-length boxes; visuals carry no collision. -->
<sdf version="1.10">
  <model name="tunnel_walls">
    <static>true</static>
    <link name="link">
      <collision name="c_left">
        <pose>100 2 1.5 0 0 0</pose>
        <geometry><box><size>200 0.2 3</size></box></geometry>
      </collision>
      <collision name="c_right">
        <pose>100 -2 1.5 0 0 0</pose>
        <geometry><box><size>200 0.2 3</size></box></geometry>
      </collision>
      <visual name="wl_000">
