<?xml version="1.0" ?>
<!-- A.E.T.H.E.R tunnel walls (U4 world v2): the 200 m corridor as a single static
     model of repeated 10 m PBR-textured panels (y = +/-2, height 3, centered z=1.5).
     Every panel uses feature_rich.png (checker+noise: dense tracker food) EXCEPT
     the deliberate feature-starvation stretch at x = 120..140, which uses the
     near-uniform bare.png on BOTH walls - that is where VIO quality collapses and
     the integrity layer earns its keep. Textures are generated deterministically
     by sim/textures/gen_textures.py. Collision is two full-length boxes (cheap
     physics); the panels are visual-only. -->
<sdf version="1.10">
  <model name="tunnel_walls">
    <static>true</static>
    <link name="link">
      <collision name="c_left">
        <pose>100 2 1.5 0 0 0</pose>
        <geometry><box><size>200 0.2 3</size></box></geometry>
      </collision>
      <collision name="c_right">
        <pose>100 -2 1.5 0 0 0</pose>
        <geometry><box><size>200 0.2 3</size></box></geometry>
      </collision>
      <visual name="wl_005">
        <pose>5 2 1.5 0 0 0</pose>
        <geometry><box><size>10 0.2 3</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>model://tunnel_walls/materials/textures/feature_rich.png</albedo_map>
            <roughness>0.9</roughness><metalness>0.0</metalness>
          </metal></pbr>
        </material>
      </visual>
      <visual name="wl_015">
