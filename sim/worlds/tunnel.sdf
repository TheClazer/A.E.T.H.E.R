<?xml version="1.0" ?>
<!-- A.E.T.H.E.R GPS-denied tunnel world (Gazebo Harmonic / gz-sim).
     200 m textured corridor; the drone model carries stereo + IMU + ground-truth. -->
<sdf version="1.10">
  <world name="aether_tunnel">

    <!-- mandatory Harmonic system plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.8</gravity>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- floor -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>220 8</size></plane></geometry></collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>220 8</size></plane></geometry>
          <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.4 0.4 0.43 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- two textured walls forming a 200 m corridor (features for the tracker) -->
    <model name="wall_left">
      <static>true</static>
      <pose>100 2 1.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>200 0.2 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>200 0.2 3</size></box></geometry>
          <material><ambient>0.55 0.5 0.45 1</ambient><diffuse>0.7 0.65 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_right">
      <static>true</static>
      <pose>100 -2 1.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>200 0.2 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>200 0.2 3</size></box></geometry>
          <material><ambient>0.55 0.5 0.45 1</ambient><diffuse>0.7 0.65 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- a deliberately FEATURE-POOR stretch (bare wall) for the integrity story -->
    <model name="bare_patch_left">
      <static>true</static>
      <pose>120 1.85 1.5 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>20 0.05 3</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- the A.E.T.H.E.R drone (stereo + IMU + ground-truth publisher) -->
    <include>
      <uri>model://aether_drone</uri>
      <name>aether_drone</name>
      <pose>0 0 1.2 0 0 0</pose>
    </include>

  </world>
</sdf>
