<?xml version="1.0" ?>
<!-- A.E.T.H.E.R GPS-denied tunnel world (Gazebo Harmonic / gz-sim).
     200 m textured corridor; the drone model carries stereo + IMU + ground-truth. -->
<sdf version="1.10">
  <world name="aether_tunnel">

    <!-- mandatory Harmonic system plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.8</gravity>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- floor -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>220 8</size></plane></geometry></collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>220 8</size></plane></geometry>
          <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.4 0.4 0.43 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- world v2 (U4): textured corridor walls live in their own model —
         repeated 10 m PBR panels, feature-rich everywhere except the bare
         (feature-poor) stretch at x = 120..140 for the integrity story.
         See sim/models/tunnel_walls + sim/textures/gen_textures.py. -->
    <include>
      <uri>model://tunnel_walls</uri>
      <name>tunnel_walls</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- the A.E.T.H.E.R drone (stereo + IMU + ground-truth publisher) -->
    <include>
      <uri>model://aether_drone</uri>
      <name>aether_drone</name>
      <pose>0 0 1.2 0 0 0</pose>
    </include>

  </world>
</sdf>
