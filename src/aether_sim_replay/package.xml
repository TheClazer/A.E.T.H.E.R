<?xml version="1.0"?>
<package format="3">
  <name>aether_sim_replay</name>
  <version>0.1.0</version>
  <description>A.E.T.H.E.R guaranteed live demo: publishes a representative VIO trajectory
   (odometry + covariance + feature count + ground truth) that drives the REAL integrity
   stack in ROS2 — independent of OpenVINS/Gazebo. The visual demo that cannot fail.</description>
  <maintainer email="therayyn16@gmail.com">TheClazer</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>aether_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
